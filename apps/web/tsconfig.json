{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker.ImportScripts"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "next/navigation": [
        "src/shims/next-navigation.ts"
      ],
      "next/link": [
        "src/shims/next-link.tsx"
      ],
      "next/image": [
        "src/shims/next-image.tsx"
      ]
    }
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "src/sw.ts"
  ]
}
